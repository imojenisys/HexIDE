+internal sealed class RestartNetworkEvents : System.Diagnostics.Tracing.EventListener
+{
+    private readonly System.Collections.Concurrent.ConcurrentQueue<string> events = new();
+    protected override void OnEventSourceCreated(System.Diagnostics.Tracing.EventSource source)
+    {
+        if (source.Name is "System.Net.Http" or "System.Net.Sockets" or "System.Net.NameResolution")
+            EnableEvents(source, System.Diagnostics.Tracing.EventLevel.Verbose);
+    }
+    protected override void OnEventWritten(System.Diagnostics.Tracing.EventWrittenEventArgs args)
+    {
+        events?.Enqueue($"{System.Diagnostics.Stopwatch.GetTimestamp()} {args.EventSource.Name} {args.EventName} {string.Join(", ", args.Payload?.ToArray() ?? [])}");
+    }
+    public void Mark(string text) => events.Enqueue(text);
+    public void Flush()
+    {
+        var lines = new List<string>();
+        while (events.TryDequeue(out var line)) lines.Add(line);
+        File.AppendAllLines(Environment.GetEnvironmentVariable("HEXIDE_778_TRACE")!, lines);
+    }
+}
